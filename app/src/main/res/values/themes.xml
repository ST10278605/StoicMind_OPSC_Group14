<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StoicMind" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorTextLight</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorGold</item>
        <item name="colorOnSecondary">@color/colorTextLight</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/colorBackground</item>

        <!-- TextInputLayout Theme -->
        <item name="textInputStyle">@style/Widget.StoicMind.TextInputLayout</item>
    </style>

    <!-- Additional Theme Variants for Theme Selection Configuration -->
    <style name="Theme.StoicMind.Serene" parent="Theme.StoicMind">
        <item name="colorPrimary">#008080</item>
        <item name="colorPrimaryVariant">#004D40</item>
        <item name="colorSecondary">#4DB6AC</item>
        <item name="colorSecondaryVariant">#00695C</item>
        <item name="android:statusBarColor">#004D40</item>
        <item name="android:windowBackground">#E0F2F1</item>
    </style>

    <style name="Theme.StoicMind.Courage" parent="Theme.StoicMind">
        <item name="colorPrimary">#800020</item>
        <item name="colorPrimaryVariant">#4A0011</item>
        <item name="colorSecondary">#C62828</item>
        <item name="colorSecondaryVariant">#B71C1C</item>
        <item name="android:statusBarColor">#4A0011</item>
        <item name="android:windowBackground">#FDF2F4</item>
    </style>

    <style name="Theme.StoicMind.Nature" parent="Theme.StoicMind">
        <item name="colorPrimary">#2E5A44</item>
        <item name="colorPrimaryVariant">#143525</item>
        <item name="colorSecondary">#689F38</item>
        <item name="colorSecondaryVariant">#33691E</item>
        <item name="android:statusBarColor">#143525</item>
        <item name="android:windowBackground">#E8F5E9</item>
    </style>

    <style name="Widget.StoicMind.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="startIconTint">@color/colorTextSecondary</item>
        <item name="endIconTint">@color/colorTextSecondary</item>
    </style>

    <style name="Theme.StoicMind.Splash" parent="Theme.StoicMind">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>